{
    "name": "popphp/pop-css",
    "description": "Pop CSS Component for Pop PHP Framework",
    "keywords": [
        "css generation",
        "css parsing",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-css",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-color": "^2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Css\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Css\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
